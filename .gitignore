# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/
dist/
build/

# Reports (generated at runtime)
reports/

# Preparations (plateaux enregistres par l'operateur, ecrits a l'execution).
# Ce sont des donnees de travail, pas du code : elles contiennent des coordonnees en mm
# ABSOLUES, donc liees a la position de la camera et au plateau d'UNE machine donnee.
# Les partager entre machines n'aurait pas de sens. Le dossier est recree tout seul au
# premier enregistrement (os.makedirs dans modules/preparation.py).
preparations/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Configuration locale (propre à chaque machine — ne pas committer)
local_config.json

# Calibration caméra — dépend du capteur/objectif physique de chaque machine,
# ne doit pas être partagée entre machines différentes (voir local_config.json)
assets/camera_calibration.npz

# Sorties de repli du generateur de planches, quand le fichier principal est
# ouvert dans PowerPoint : ce sont des doublons horodates, jamais a commiter.
assets/bilan_soutenance_*.pptx
